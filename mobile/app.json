{
  "expo": {
    "name": "Marginal",
    "slug": "marginal-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#2b1f63"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.marginal.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#6b4bff"
        }
      ]
    ],
    "notification": {
      "color": "#6b4bff"
    }
  }
}
